# Production Environment Configuration Template
# Project: cpetak-timetable
# Instructions: Copy this file to .env.production on the production host and provide actual secret values.
# IMPORTANT: Never commit actual production secrets to git.

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Connection URL for dedicated production MySQL 8.0 instance.
# Create a dedicated non-root application user with least-privilege permissions:
# GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES ON timetable_prod.* TO 'timetable_app'@'127.0.0.1';
DATABASE_URL="mysql://timetable_app:STRONG_DATABASE_PASSWORD_HERE@127.0.0.1:3306/timetable_prod"

# -----------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Generate a cryptographically strong 32+ character secret using:
# openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_OPENSSL_BASE64_32_CHAR_SECRET_MINIMUM"

# Canonical public HTTPS URL of your application
NEXTAUTH_URL="https://timetable.cpetak.ac.th"

# Node environment mode
NODE_ENV="production"

# Next.js Server Port (internal port bound to localhost for reverse proxy)
PORT=3000

# -----------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR CREDENTIALS
# -----------------------------------------------------------------------------
# Credentials for the primary system administrator account.
# IMPORTANT: Choose a non-default username and a high-entropy password (min 16 chars).
ADMIN_USERNAME="cpetak_admin"
ADMIN_PASSWORD="REPLACE_WITH_HIGH_ENTROPY_PASSWORD_MIN_16_CHARS"
